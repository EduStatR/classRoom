stop_num(m.erro > 0, "'m.erro' deve ser positivo.")
n <- n_prop(prop, m.erro, conf.level, round.up)
if (print) cabecalho("Estimativa de proporção", conf.level, m.erro, n)
return(invisible(list(
n = n, prop = prop, m.erro = m.erro, conf.level = conf.level, tipo = 1
)))
}
if (tipo == 2) {
# Média, variância desconhecida: s.ap, n.ap, m.erro, iter (opcional)
if (!is.null(args$s.ap) && !is.null(args$n.ap) && !is.null(args$m.erro)) {
s.ap   <- get_num(args$s.ap, "s.ap")
n.ap   <- get_num(args$n.ap, "n.ap")
m.erro <- get_num(args$m.erro, "m.erro")
iter_flag <- if (!is.null(args$iter)) as.logical(args$iter) else FALSE
} else if (editor == "edit" && is_interactive) {
df <- data.frame(s.ap = NA_real_, n.ap = NA_integer_, m.erro = NA_real_, iter = FALSE)
df <- utils::edit(df)
s.ap   <- get_num(df$s.ap[1], "s.ap")
n.ap   <- get_num(df$n.ap[1], "n.ap")
m.erro <- get_num(df$m.erro[1], "m.erro")
iter_flag <- as.logical(df$iter[1])
} else if (editor == "view" && is_interactive) {
df <- data.frame(s.ap = NA_real_, n.ap = NA_integer_, m.erro = NA_real_, iter = FALSE)
utils::View(df)
s.ap   <- get_num(readline("Informe s.ap (desvio-padrão amostral, ex.: 2): "), "s.ap")
n.ap   <- get_num(readline("Informe n.ap (tamanho piloto, ex.: 10): "), "n.ap")
m.erro <- get_num(readline("Informe m.erro (erro tolerado, ex.: 1.2): "), "m.erro")
iter_flag <- as.logical(readline("Iterativo? (TRUE/FALSE): "))
} else {
stop("Para tipo = 2 forneça 's.ap', 'n.ap' e 'm.erro' em ... ou use editor = 'edit'/'view' interativamente.", call. = FALSE)
}
stop_num(s.ap > 0, "'s.ap' deve ser positivo.")
stop_num(n.ap > 1, "'n.ap' deve ser maior que 1.")
stop_num(m.erro > 0, "'m.erro' deve ser positivo.")
n <- n_media_var_desconhecida(
s.ap, n.ap, m.erro, conf.level,
iter = iter_flag, tolerancia = tolerancia, max_iter = max_iter,
round.up = round.up
)
if (print) cabecalho("Estimativa da média (variância desconhecida)", conf.level, m.erro, n)
return(invisible(list(
n = n, s.ap = s.ap, n.ap = n.ap, m.erro = m.erro,
iter = iter_flag, conf.level = conf.level, tipo = 2
)))
}
if (tipo == 3) {
# Média, variância conhecida: sigma, m.erro
if (!is.null(args$sigma) && !is.null(args$m.erro)) {
sigma  <- get_num(args$sigma, "sigma")
m.erro <- get_num(args$m.erro, "m.erro")
} else if (editor == "edit" && is_interactive) {
df <- data.frame(sigma = NA_real_, m.erro = NA_real_)
df <- utils::edit(df)
sigma  <- get_num(df$sigma[1], "sigma")
m.erro <- get_num(df$m.erro[1], "m.erro")
} else if (editor == "view" && is_interactive) {
df <- data.frame(sigma = NA_real_, m.erro = NA_real_)
utils::View(df)
sigma  <- get_num(readline("Informe sigma (desvio-padrão populacional, ex.: 2): "), "sigma")
m.erro <- get_num(readline("Informe m.erro (erro tolerado, ex.: 1.2): "), "m.erro")
} else {
stop("Para tipo = 3 forneça 'sigma' e 'm.erro' em ... ou use editor = 'edit'/'view' interativamente.", call. = FALSE)
}
stop_num(sigma > 0, "'sigma' deve ser positivo.")
stop_num(m.erro > 0, "'m.erro' deve ser positivo.")
n <- n_media_var_conhecida(sigma, m.erro, conf.level, round.up)
if (print) cabecalho("Estimativa da média (variância conhecida)", conf.level, m.erro, n)
return(invisible(list(
n = n, sigma = sigma, m.erro = m.erro, conf.level = conf.level, tipo = 3
)))
}
stop("Tipo inválido. Use: 1 = proporção, 2 = média (variância desconhecida), 3 = média (variância conhecida).", call. = FALSE)
}
tamanho.amostral(tipo = 1, conf.level = 0.90)
tamanho.amostral <- function(
tipo = 1,
conf.level = 0.95,
editor = c("edit", "none", "view"),
round.up = FALSE,
tolerancia = 0.01,
max_iter = 100,
print = TRUE,
...
) {
editor <- match.arg(editor)
args <- list(...)
is_interactive <- interactive()
# -------- Helpers --------
stop_num <- function(ok, msg) if (!ok) stop(msg, call. = FALSE)
get_num <- function(x, name) {
val <- suppressWarnings(as.numeric(x))
if (length(val) == 0 || is.na(val))
stop(paste0("Parâmetro '", name, "' inválido ou não informado."), call. = FALSE)
val
}
qz <- function(conf.level) {
alpha <- 1 - conf.level
prob <- alpha / 2
qnorm(prob, lower.tail = FALSE)
}
qt_two_sided <- function(conf.level, df) {
alpha <- 1 - conf.level
prob <- alpha / 2
qt(prob, df = df, lower.tail = FALSE)
}
cabecalho <- function(titulo, conf.level, m.erro, n){
cat("\n")
cat("=====================================\n")
cat("        Tamanho amostral\n")
cat("=====================================\n")
cat("Método:\n")
cat(" ", titulo, "\n")
cat("Confiança:\n")
cat(sprintf(" %.0f%%\n", 100 * conf.level))
cat("Margem de erro:\n")
cat(" ", m.erro, "\n")
cat("Tamanho da amostra:\n")
cat(" ", format(round(n, 4), nsmall = 4), "\n")
cat("=====================================\n")
}
# -------- Cálculos por tipo --------
n_prop <- function(prop, m.erro, conf.level, round.up) {
z <- qz(conf.level)
n <- (z * sqrt(prop * (1 - prop)) / m.erro)^2
if (round.up) ceiling(n) else n
}
n_media_var_desconhecida <- function(s.ap, n.ap, m.erro, conf.level,
iter = FALSE, tolerancia = 0.01, max_iter = 100,
round.up = FALSE) {
stop_num(n.ap > 1, "'n.ap' deve ser maior que 1 para definir graus de liberdade.")
gl <- n.ap - 1
if (!iter) {
tcrit <- qt_two_sided(conf.level, df = gl)
n <- (tcrit * s.ap / m.erro)^2
if (round.up) ceiling(n) else n
} else {
iter_count <- 0
n_ant <- 2 # ponto de partida > 1
repeat {
iter_count <- iter_count + 1
gl <- max(1, round(n_ant) - 1)
tcrit <- qt_two_sided(conf.level, df = gl)
n_novo <- (tcrit * s.ap / m.erro)^2
if (abs(n_novo - n_ant) < tolerancia || iter_count >= max_iter) {
n_final <- n_novo
break
}
n_ant <- n_novo
}
if (round.up) ceiling(n_final) else n_final
}
}
n_media_var_conhecida <- function(sigma, m.erro, conf.level, round.up) {
z <- qz(conf.level)
n <- (z * sigma / m.erro)^2
if (round.up) ceiling(n) else n
}
# -------- Entrada por tipo --------
if (tipo == 1) {
# Proporção: prop, m.erro
if (!is.null(args$prop) && !is.null(args$m.erro)) {
prop   <- get_num(args$prop, "prop")
m.erro <- get_num(args$m.erro, "m.erro")
} else if (editor == "edit" && is_interactive) {
df <- data.frame(prop = NA_real_, m.erro = NA_real_)
df <- utils::edit(df)
prop   <- get_num(df$prop[1], "prop")
m.erro <- get_num(df$m.erro[1], "m.erro")
} else if (editor == "view" && is_interactive) {
df <- data.frame(prop = NA_real_, m.erro = NA_real_)
utils::View(df)
prop   <- get_num(readline("Informe prop (ex.: 0.5): "), "prop")
m.erro <- get_num(readline("Informe m.erro (ex.: 0.02): "), "m.erro")
} else {
stop("Para tipo = 1 forneça 'prop' e 'm.erro' em ... ou use editor = 'edit'/'view' interativamente.", call. = FALSE)
}
stop_num(prop > 0 && prop < 1, "'prop' deve estar entre 0 e 1 (exclusivo).")
stop_num(m.erro > 0, "'m.erro' deve ser positivo.")
n <- n_prop(prop, m.erro, conf.level, round.up)
if (print) cabecalho("Estimativa de proporção", conf.level, m.erro, n)
return(invisible(list(
n = n, prop = prop, m.erro = m.erro, conf.level = conf.level, tipo = 1
)))
}
if (tipo == 2) {
# Média, variância desconhecida: s.ap, n.ap, m.erro, iter (opcional)
if (!is.null(args$s.ap) && !is.null(args$n.ap) && !is.null(args$m.erro)) {
s.ap   <- get_num(args$s.ap, "s.ap")
n.ap   <- get_num(args$n.ap, "n.ap")
m.erro <- get_num(args$m.erro, "m.erro")
iter_flag <- if (!is.null(args$iter)) as.logical(args$iter) else FALSE
} else if (editor == "edit" && is_interactive) {
df <- data.frame(s.ap = NA_real_, n.ap = NA_integer_, m.erro = NA_real_, iter = FALSE)
df <- utils::edit(df)
s.ap   <- get_num(df$s.ap[1], "s.ap")
n.ap   <- get_num(df$n.ap[1], "n.ap")
m.erro <- get_num(df$m.erro[1], "m.erro")
iter_flag <- as.logical(df$iter[1])
} else if (editor == "view" && is_interactive) {
df <- data.frame(s.ap = NA_real_, n.ap = NA_integer_, m.erro = NA_real_, iter = FALSE)
utils::View(df)
s.ap   <- get_num(readline("Informe s.ap (desvio-padrão amostral, ex.: 2): "), "s.ap")
n.ap   <- get_num(readline("Informe n.ap (tamanho piloto, ex.: 10): "), "n.ap")
m.erro <- get_num(readline("Informe m.erro (erro tolerado, ex.: 1.2): "), "m.erro")
iter_flag <- as.logical(readline("Iterativo? (TRUE/FALSE): "))
} else {
stop("Para tipo = 2 forneça 's.ap', 'n.ap' e 'm.erro' em ... ou use editor = 'edit'/'view' interativamente.", call. = FALSE)
}
stop_num(s.ap > 0, "'s.ap' deve ser positivo.")
stop_num(n.ap > 1, "'n.ap' deve ser maior que 1.")
stop_num(m.erro > 0, "'m.erro' deve ser positivo.")
n <- n_media_var_desconhecida(
s.ap, n.ap, m.erro, conf.level,
iter = iter_flag, tolerancia = tolerancia, max_iter = max_iter,
round.up = round.up
)
if (print) cabecalho("Estimativa da média (variância desconhecida)", conf.level, m.erro, n)
return(invisible(list(
n = n, s.ap = s.ap, n.ap = n.ap, m.erro = m.erro,
iter = iter_flag, conf.level = conf.level, tipo = 2
)))
}
if (tipo == 3) {
# Média, variância conhecida: sigma, m.erro
if (!is.null(args$sigma) && !is.null(args$m.erro)) {
sigma  <- get_num(args$sigma, "sigma")
m.erro <- get_num(args$m.erro, "m.erro")
} else if (editor == "edit" && is_interactive) {
df <- data.frame(sigma = NA_real_, m.erro = NA_real_)
df <- utils::edit(df)
sigma  <- get_num(df$sigma[1], "sigma")
m.erro <- get_num(df$m.erro[1], "m.erro")
} else if (editor == "view" && is_interactive) {
df <- data.frame(sigma = NA_real_, m.erro = NA_real_)
utils::View(df)
sigma  <- get_num(readline("Informe sigma (desvio-padrão populacional, ex.: 2): "), "sigma")
m.erro <- get_num(readline("Informe m.erro (erro tolerado, ex.: 1.2): "), "m.erro")
} else {
stop("Para tipo = 3 forneça 'sigma' e 'm.erro' em ... ou use editor = 'edit'/'view' interativamente.", call. = FALSE)
}
stop_num(sigma > 0, "'sigma' deve ser positivo.")
stop_num(m.erro > 0, "'m.erro' deve ser positivo.")
n <- n_media_var_conhecida(sigma, m.erro, conf.level, round.up)
if (print) cabecalho("Estimativa da média (variância conhecida)", conf.level, m.erro, n)
return(invisible(list(
n = n, sigma = sigma, m.erro = m.erro, conf.level = conf.level, tipo = 3
)))
}
stop("Tipo inválido. Use: 1 = proporção, 2 = média (variância desconhecida), 3 = média (variância conhecida).", call. = FALSE)
}
